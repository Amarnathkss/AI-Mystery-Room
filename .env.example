# Local server configuration. Copy this file to .env and fill in MONGODB_URI.
NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
COOKIE_NAME=amr_guest

# Required: use a local MongoDB URI or an Atlas connection string.
MONGODB_URI=mongodb://127.0.0.1:27017/ai_mystery_room

# The mock provider is fully supported and needs no API key.
AI_PROVIDER=mock
